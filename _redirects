# ── Legacy WordPress patterns reported in GSC (404) ──
# Author pages, attachments, wp-admin, wp-*.php → home
/author/*           /  410
/wp-admin/*         /  410
/wp-content/*       /  410
/wp-includes/*      /  410
/wp-login.php       /  410
/wp-cron.php        /  410
/xmlrpc.php         /  410
/feed/              /  410
/feed/*             /  410
/comments/feed/     /  410
/?feed=*            /  410

